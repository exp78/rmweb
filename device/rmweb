#!/bin/sh
# rmweb — production launcher (runs ON the reMarkable Paper Pro). Stops xochitl, sets up the WPE runtime,
# runs the browser, and ALWAYS restores xochitl on exit (clean quit, crash, or kill) so the device is never
# left with a blank panel. See docs/superpowers/specs/2026-06-30-rmweb-phase5-packaging-design.md.
set -u
R="${RMWEB_ROOT:-/home/root/rmweb}"
LOCK="$R/.lock"
LOG="$R/rmweb.log"
log(){ echo "[rmweb] $*" >> "$LOG"; }

# The log lives on flash and the app appends to it for its whole lifetime — keep it bounded:
# before a big append, if it exceeds 5 MB cut it back to the last ~1 MB. BusyBox-compatible
# (wc/tail/mv); never fatal — a rotation failure must not stop the launcher.
rotate_log(){
  [ -f "$LOG" ] || return 0
  size=$(wc -c < "$LOG" 2>/dev/null | tr -dc '0-9')
  if [ -n "$size" ] && [ "$size" -gt 5242880 ]; then
    if tail -c 1048576 "$LOG" > "$LOG.rot" 2>/dev/null; then
      mv "$LOG.rot" "$LOG"
      log "log rotated (was ${size} bytes, kept last 1 MB)"
    else
      rm -f "$LOG.rot"
    fi
  fi
  return 0
}

DONE=
cleanup(){
  [ -n "$DONE" ] && return; DONE=1
  [ -n "${APP:-}" ] && kill "$APP" 2>/dev/null                       # stop the app if still running
  for n in rmweb-wpeqt WPEWebProcess WPENetworkProc WPEGPUProcess; do # + any lingering WPE subprocesses
    # shellcheck disable=SC2046
    # word-splitting is intentional: pgrep returns space-separated PIDs, one kill per PID
    for p in $(pgrep "$n" 2>/dev/null); do kill -9 "$p" 2>/dev/null; done
  done
  # kill/kill -9 are async: wait until the app is actually gone and has released the
  # epaper framebuffer, otherwise xochitl starts into a held framebuffer and crashes.
  i=0; while pgrep rmweb-wpeqt >/dev/null 2>&1 && [ "$i" -lt 10 ]; do sleep 1; i=$((i+1)); done
  sleep 2
  # xochitl has StartLimitIntervalSec=600/Burst=4 and OnFailure=emergency.target: a handful of
  # stops/starts within 10 min (xovi toggle + rmweb launch/quit cycles) trips an EMERGENCY REBOOT.
  # Clear the burst counter so this legitimate restore start can never be the one that trips it.
  if [ -n "${STOPPED:-}" ]; then
    log "restarting xochitl"; systemctl reset-failed xochitl 2>/dev/null; systemctl start xochitl  # home UI back FIRST
    # A start that only LOOKS fine leaves the user on a blank panel: verify, retry once, then warn.
    if ! systemctl is-active --quiet xochitl; then
      sleep 2; systemctl reset-failed xochitl 2>/dev/null; systemctl start xochitl
    fi
    systemctl is-active --quiet xochitl || log "WARN: xochitl still not active after restart"
  fi
  [ -n "${MOUNTED:-}" ] && umount /usr/libexec 2>/dev/null
  rmdir "$LOCK" 2>/dev/null
}
trap 'cleanup' EXIT
trap 'cleanup; exit 143' TERM
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 129' HUP   # dropped ssh must not strand the device with xochitl stopped + lock held

# Single instance (mkdir is atomic on BusyBox). The lock dir survives reboots (e.g. an emergency-reboot
# while rmweb ran): if no rmweb-wpeqt is alive the lock is stale — take it over instead of refusing every
# future start. With a LIVE process behind the lock, bail without touching xochitl (DONE=1 so the EXIT
# trap's cleanup is a no-op and won't restart xochitl under the other run).
if ! mkdir "$LOCK" 2>/dev/null; then
  if ! pgrep rmweb-wpeqt >/dev/null 2>&1; then
    echo "[rmweb] stale $LOCK (no rmweb-wpeqt running) — taking over" >&2
    rmdir "$LOCK" 2>/dev/null || rm -rf "$LOCK"
    mkdir "$LOCK" 2>/dev/null || { echo "[rmweb] could not acquire $LOCK" >&2; DONE=1; exit 1; }
  else
    echo "[rmweb] already running (lock $LOCK held by a live rmweb-wpeqt)" >&2
    DONE=1; exit 1
  fi
fi

rotate_log   # bound the persistent log before this run's appends
log "start"
if systemctl is-active --quiet xochitl; then
  log "stopping xochitl"
  # STOPPED before the stop: on the appload fallback path (no systemd-run) the stop SIGTERMs our own
  # cgroup — a TERM landing mid-stop must still find STOPPED set so cleanup restarts xochitl.
  STOPPED=1
  if ! systemctl stop xochitl; then STOPPED=; log "ERROR: could not stop xochitl"; exit 1; fi
fi

# WPE spawns helpers from the baked /usr/libexec/wpe-webkit-2.0 and / is read-only -> overlay it. Drop any
# stale overlay from a hard-killed prior run first, so we always mount our fresh helpers.
umount /usr/libexec 2>/dev/null || true
if [ ! -e /usr/libexec/wpe-webkit-2.0 ]; then
  rm -rf "$R/ovl"; mkdir -p "$R/ovl/upper/wpe-webkit-2.0" "$R/ovl/work"
  cp -a "$R/libexec/wpe-webkit-2.0/." "$R/ovl/upper/wpe-webkit-2.0/"
  # A silently failed overlay leaves WPE unable to spawn its subprocesses — bail (trap restores xochitl).
  if ! mount -t overlay overlay -o "lowerdir=/usr/libexec,upperdir=$R/ovl/upper,workdir=$R/ovl/work" /usr/libexec; then
    log "ERROR: overlay mount on /usr/libexec failed"
    exit 1
  fi
  MOUNTED=1
fi

# shellcheck source=/dev/null
. "$R/rmweb-env.sh"

rotate_log   # the app's own append below is the main growth source
log "launch rmweb-wpeqt $*"
"$R/bin/rmweb-wpeqt" "$@" >> "$LOG" 2>&1 &
APP=$!
wait "$APP"
log "rmweb-wpeqt exited rc=$?"
# EXIT trap -> cleanup -> restores xochitl.
