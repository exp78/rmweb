# reMarkable Paper Pro — SSH connection (copy to .env). Auth is by SSH key:
#   ssh-copy-id root@10.11.99.1
REMARKABLE_HOST=10.11.99.1
REMARKABLE_USER=root
# Legacy alias still honored by the scripts as a fallback — prefer REMARKABLE_USER.
# DEVICE_USER=root
# NOT USED — key auth only; no script reads this and it never reaches a command line:
# REMARKABLE_PASSWORD=
