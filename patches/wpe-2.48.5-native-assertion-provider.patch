diff --git a/Source/WebKit/UIProcess/WebAuthentication/wpe/WebAuthenticatorCoordinatorProxyWPE.cpp b/Source/WebKit/UIProcess/WebAuthentication/wpe/WebAuthenticatorCoordinatorProxyWPE.cpp
